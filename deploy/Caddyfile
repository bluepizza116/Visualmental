# Caddy site config for Prism.
#
# A template: deploy.sh fills in the domain and web root below, then installs
# the result as /etc/caddy/sites/visualmental.caddyfile. It is imported by your
# main Caddyfile and does not replace it.
#
# Defaults are visualmental.163-245-220-226.nip.io and /var/www/visualmental;
# override with the DOMAIN and WEB_ROOT environment variables.

__DOMAIN__ {
	encode zstd gzip

	header {
		# Prism is entirely self-contained — no CDNs, no fonts, no network calls —
		# so everything can be locked to 'self'. The inline allowances are needed
		# because the whole app is one <style> and one <script> in index.html.
		# blob: on script-src/worker-src is required by the vinyl and tape skins:
		# the AudioWorklet that does signed-rate playback is built from a Blob URL.
		# connect-src includes lrclib.net because lyrics are fetched straight
		# from the browser (it is keyless and sends CORS headers). Artwork is
		# NOT listed: those CDNs send no CORS headers, so it is proxied through
		# /api instead, which keeps the canvas untainted for palette extraction.
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' blob:; worker-src blob:; child-src blob:; style-src 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; connect-src 'self' https://lrclib.net; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

		# The mic and tab-capture sources need these explicitly granted; a
		# restrictive default would silently break two of the three inputs.
		Permissions-Policy "microphone=(self), display-capture=(self), fullscreen=(self), camera=(), geolocation=()"

		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"

		# Deliberately short: this is an IP-derived nip.io host, so a year-long
		# pin would be painful if you ever need to serve it over plain HTTP.
		Strict-Transport-Security "max-age=2592000"

		-Server
	}

	# The download service (server/prismd.py), if installed. It binds to
	# localhost and does its own bearer-token auth; this only routes to it.
	# Nothing is proxied unless the service is actually running.
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8770 {
			# Resolving a large playlist can take a while before the first byte.
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		root * __WEB_ROOT__
		file_server

		# The app is a single file that changes on every deploy, so it must not
		# be cached; any assets you add later are safe to cache hard.
		header /index.html Cache-Control "no-cache, must-revalidate"
		@assets path *.png *.jpg *.jpeg *.svg *.webp *.woff2 *.ico
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	log {
		output file /var/log/caddy/visualmental.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
